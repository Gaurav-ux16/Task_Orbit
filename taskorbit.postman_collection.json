      "key": "springBootUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "csrfToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoPassword",
      "value": "TaskOrbit@2026!",
      "type": "string"
    }
  ],
