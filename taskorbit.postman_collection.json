        {
          "name": "Login — Project Manager (bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds and sets an HttpOnly session cookie', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly');",
                  "});",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().data.csrfToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
