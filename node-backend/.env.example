PORT=3001
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API with cookies.
# REQUIRED in production (e.g. https://app.example.com)
FRONTEND_URL=http://localhost:5173

# Supabase configuration
# NOTE: SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_STORAGE_BUCKET=taskorbit-files

# Dev resiliency: if the cloud Supabase project is unreachable, setting
# USE_MOCK_FALLBACK=true enables the embedded demo store. NEVER in production
# (the server refuses to start in production on the demo store).
USE_MOCK_FALLBACK=false

# ── Sessions & cookies ─────────────────────────────────────────────────────────
# Cookie SameSite policy: lax (default) | strict | none (cross-site, HTTPS only)
COOKIE_SAMESITE=lax
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
SESSION_REMEMBER_DAYS=30

# ── Brute-force / flood protection ──────────────────────────────────────────────
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_MAX=20      # login/register attempts per IP per 15 min
RATE_LIMIT_MAX=600          # API requests per IP per 15 min
BCRYPT_COST=12

# Number of reverse proxies in front of the API (so req.ip is the real client)
# TRUST_PROXY=1
