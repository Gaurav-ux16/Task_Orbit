PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase configuration (reusing existing project credentials)
# NOTE: SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_STORAGE_BUCKET=taskorbit-files

# Dev resiliency: if the cloud Supabase project is paused or unreachable,
# setting USE_MOCK_FALLBACK=true enables the embedded seed store for local dev.
USE_MOCK_FALLBACK=false
